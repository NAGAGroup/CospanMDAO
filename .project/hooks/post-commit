#!/usr/bin/env nu

# Runs on every commit in a repo set_up_project_knowledge set up. Must never
# fail the commit: every path that can go wrong lands in the catch, which
# prints one line to stderr and lets the script exit 0.
try {
    let token = ($env.HINDSIGHT_API_TOKEN? | default "")
    if ($token | str trim | is-empty) {
        print -e "post-commit: HINDSIGHT_API_TOKEN not set; skipping memory retain"
    } else {
        let root = (git rev-parse --show-toplevel | str trim)
        let bank_file = ($root | path join ".project" "bank.txt")
        if not ($bank_file | path exists) {
            print -e "post-commit: no .project/bank.txt; skipping memory retain"
        } else {
            let bank = (open $bank_file | str trim)
            let show_current = (git branch --show-current | str trim)
            # Mid-rebase, --show-current is empty; the branch being rebased
            # is named in this file instead.
            let branch = if ($show_current | is-empty) {
                let head_name_path = (git rev-parse --git-path rebase-merge/head-name | str trim)
                if ($head_name_path | path exists) {
                    (open $head_name_path | str trim | str replace "refs/heads/" "")
                } else {
                    ""
                }
            } else {
                $show_current
            }
            if ($branch | is-empty) {
                print -e "post-commit: not on a branch and not mid-rebase; skipping memory retain"
            } else {
                let sha = (git rev-parse HEAD | str trim)
                let commit_time = (git show -s --format=%cI HEAD | str trim | into datetime | date to-timezone UTC | format date "%FT%TZ")
                let diff = (git show --diff-merges=first-parent HEAD)
                let item = {
                    content: $diff,
                    tags: [$"branch:($branch)"],
                    metadata: {commit: $sha, type: "diff"},
                    timestamp: $commit_time,
                }
                let body = {items: [$item], async: true, operation_id: (random uuid)}
                http post --content-type application/json --headers [Authorization $"Bearer ($token)"] --max-time 10sec $"https://api.hindsight.vectorize.io/v1/default/banks/($bank)/memories" $body | ignore
            }
        }
    }
} catch {|err|
    print -e $"post-commit: memory retain failed: ($err.msg)"
}
